# Copy to .env and fill in. Do not commit .env.

TZ=UTC
LOG_LEVEL=info

# Serial / OCPP identity of the wallbox
CHARGE_POINT_ID=YOUR_CHARGE_POINT_ID

# Host ports
PROXY_PORT=9100
UI_PORT=8088

# --- Secondaries (leave empty to skip that backend) ---
# Enphase IQ Energy Router (OCPP-J, usually append /<id>)
ENPHASE_OCPP_URL=ws://192.168.1.10:8083
ENPHASE_APPEND_CPID=true

# EverHome (full URL from the app; serial often already in the path)
EVERHOME_OCPP_URL=
EVERHOME_APPEND_CPID=false

# Monta (path is typically /goe{serial})
MONTA_OCPP_URL=
MONTA_APPEND_CPID=false
